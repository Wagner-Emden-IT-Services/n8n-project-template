# n8n-Projekt — Environment-Variablen
# Kopie nach .env (NICHT in Git!)
#
# WICHTIG: Diese .env versorgt NUR die Node-CLI (scripts/n8n-cli.mjs, via dotenv).
# Die ${VAR}-Expansion in .mcp.json liest sie NICHT — sie zieht ausschliesslich
# aus der Shell-Umgebung und den env-Bloecken der settings-Dateien
# (.claude/settings.local.json > settings.json > user-global).
# Fuer die MCP-Server daher zusaetzlich .claude/settings.local.json mit
# env-Block pflegen ODER `node scripts/n8n-cli.mjs env-sync` ausfuehren
# (generiert settings.local.json aus dieser .env). Danach Claude Code neu starten.
#
# NORMALERWEISE: Diese Datei wird vom /onboard-Wizard (Phase 3) gepflegt.
# Sie zeigt das full-Staging-Profil (dev/staging/prod). Bei Profil "simple"
# entfernt der Wizard die Staging-Bloecke; bei "none" bleibt nur Prod uebrig.

# === Aktives Environment ===
# Bestimmt wohin CLI und (via env-sync) die beiden MCP-Server zeigen.
# Default: dev. Bei Wechsel auf staging/prod: Werte unten austauschen,
# `node scripts/n8n-cli.mjs env-sync` ausfuehren UND Claude Code neu starten.
N8N_ACTIVE_BASE_URL=http://localhost:5678
N8N_ACTIVE_API_URL=http://localhost:5678/api/v1
N8N_ACTIVE_API_KEY=
# Vollstaendiger MCP-Endpoint des Built-in-Servers.
# Default-Pfad ist <base>/mcp-server/http (z.B. http://localhost:5678/mcp-server/http),
# in der UI verifizieren: Settings -> Instance-level MCP -> Connection details.
N8N_ACTIVE_MCP_URL=http://localhost:5678/mcp-server/http
# Access-Token aus n8n-UI generieren:
# Settings -> Instance-level MCP -> Connection details -> Access Token -> Generieren.
N8N_ACTIVE_MCP_TOKEN=
N8N_ACTIVE_ENV=dev

# === n8n Production Instance ===
# BASE_URL = Instanz-URL ohne /api/v1 (fuer offiziellen MCP-Server)
# API_URL  = BASE_URL + /api/v1 (fuer REST-API-Calls aus Node-CLI)
N8N_PROD_BASE_URL=https://n8n.example.com
N8N_PROD_API_URL=https://n8n.example.com/api/v1
N8N_PROD_API_KEY=<aus n8n Settings -> API>
N8N_PROD_MCP_URL=https://n8n.example.com/mcp-server/http
N8N_PROD_MCP_TOKEN=<aus n8n Settings -> Instance-level MCP -> Access Token>

# === n8n Staging Instance ===
N8N_STAGING_BASE_URL=https://n8n-staging.example.com
N8N_STAGING_API_URL=https://n8n-staging.example.com/api/v1
N8N_STAGING_API_KEY=
N8N_STAGING_MCP_URL=https://n8n-staging.example.com/mcp-server/http
N8N_STAGING_MCP_TOKEN=

# === n8n Dev Instance ===
N8N_DEV_BASE_URL=http://localhost:5678
N8N_DEV_API_URL=http://localhost:5678/api/v1
N8N_DEV_API_KEY=
N8N_DEV_MCP_URL=http://localhost:5678/mcp-server/http
N8N_DEV_MCP_TOKEN=

# === Slack-Notifications fuer Deploys (optional) ===
SLACK_WEBHOOK_URL=

# === Backup-Storage ===
# Lokal oder S3-Pfad
BACKUP_PATH=./backups

# === n8n Concurrency-Schutz (optional) ===
# Gehoert in die Container-Env der n8n-Instanz (nicht in dieses Tooling-Env) — queued FIFO statt Schedule-Overlap, siehe docs/runbook.md
# N8N_CONCURRENCY_PRODUCTION_LIMIT=1
