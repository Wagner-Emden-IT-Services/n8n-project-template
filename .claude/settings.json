{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$f = Join-Path $env:CLAUDE_PROJECT_DIR '.claude/hooks/graphify-preflight.ps1'; if (Test-Path -LiteralPath $f) { & $f } else { '{}' }"]
          }
        ]
      }
    ]
  }
}
