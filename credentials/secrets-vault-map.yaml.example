# Secrets-Vault-Mapping — KEINE Werte, nur Pfade!
# Diese Datei dokumentiert wo welche Credentials in deinem Secret-Store liegen
# Echte Werte: Azure Key Vault / HashiCorp Vault / AWS Secrets Manager / etc.

secrets:
  slack-api-prod:
    vault: <vault-name>
    path: <vault-path>
    secret_name: slack-api-token
    rotation: yearly
    used_by:
      - prod/prod-slack-notify.json

  http-service-prod:
    vault: <vault-name>
    path: <vault-path>
    secret_name: http-service-token
    rotation: half-yearly
    used_by:
      - prod/prod-http-sync.json

# Master encryption key für n8n credentials (N8N_ENCRYPTION_KEY)
# liegt in: <vault-name> → <vault-path> → n8n-encryption-key
# NIEMALS hier oder im Git!
