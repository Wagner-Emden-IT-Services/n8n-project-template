{
  "_comment": "Mapping-Dokumentation: Welcher Service-Credential lebt in welchem Vault-Slot. Keine Werte hier eintragen — die liegen in .env (lokal) oder GitHub Secrets (CI). Diese Datei nach config/secrets-vault-map.json kopieren und befuellen. Der /onboard-Wizard erstellt sie initial in Phase 4 anhand der gewaehlten Services.",
  "_naming_convention": "n8n-Credential-Name folgt Pattern '{Service} - {Environment}', z.B. 'Slack API - Production'. Vault-Slot folgt '{service}-{env}-{purpose}', z.B. 'slack-prod-webhook' oder '1password://Engel/Slack/Production'.",
  "schema_version": "1.0",
  "secrets": [
    {
      "service": "n8n",
      "environment": "production",
      "n8n_credential_name": "n/a (instance API)",
      "vault_slot": "GITHUB_SECRET:N8N_PROD_API_KEY",
      "purpose": "Production n8n API authentication for deploy workflows",
      "rotation_policy": "yearly"
    },
    {
      "service": "n8n",
      "environment": "production",
      "n8n_credential_name": "n/a (instance MCP)",
      "vault_slot": "ENV:N8N_PROD_MCP_TOKEN",
      "purpose": "Production n8n Instance-level MCP token",
      "rotation_policy": "yearly"
    }
  ]
}
